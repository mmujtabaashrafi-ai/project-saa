# ==============================
# SERVER CONFIGURATION
# ==============================
PORT=5000
NODE_ENV=development

# ==============================
# MONGODB
# ==============================
# Local:
MONGODB_URI=mongodb://localhost:27017/react-boat
# Atlas example:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/react-boat

# ==============================
# JWT
# ==============================
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# ==============================
# SESSION LIMIT
# ==============================
MAX_ACTIVE_USERS=5

# ==============================
# AI PROVIDER
# ==============================
# Set AI_PROVIDER to one of: openai | gemini | anthropic | fallback
AI_PROVIDER=fallback

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ==============================
# CLIENT ORIGIN (for CORS)
# ==============================
CLIENT_ORIGIN=http://localhost:5173

# ==============================
# SEED PASSWORDS (only used by seed script, never sent to client)
# ==============================
SEED_ADMIN_PASSWORD=mujjubhi143
SEED_SABA_PASSWORD=sabathepurestlady
SEED_DEFAULT_USER_PASSWORD=ReactBoat@2024
